# PostgreSQL
POSTGRES_DB=pulkovo
POSTGRES_USER=pulkovo
POSTGRES_PASSWORD=secret
DATABASE_URL=postgresql+asyncpg://pulkovo:secret@postgres:5432/pulkovo

# Ollama
OLLAMA_URL=http://ollama:11434

# Qdrant
QDRANT_URL=http://qdrant:6333

# 1C Integration
ONEC_URL=https://1c.pulkovo.internal/api
ONEC_TOKEN=your_1c_token_here

# Diadoc (Kontur)
DIADOC_API_URL=https://diadoc-api.kontur.ru
DIADOC_API_KEY=your_diadoc_api_key_here

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
