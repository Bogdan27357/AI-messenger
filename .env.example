# ============ Infrastructure ============
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mas_db
POSTGRES_USER=mas_user
POSTGRES_PASSWORD=mas_secret_password

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=mas_redis_password

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=mas_user
RABBITMQ_PASSWORD=mas_rabbit_password

# ============ Ollama ============
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL_PRIMARY=qwen2.5:32b
OLLAMA_MODEL_FAST=qwen2.5:7b
OLLAMA_MODEL_EMBEDDING=nomic-embed-text
OLLAMA_MODEL_VISION=llava:13b
OLLAMA_TIMEOUT=300

# ============ Qdrant ============
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# ============ MinIO ============
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=mas_minio_user
MINIO_SECRET_KEY=mas_minio_password
MINIO_BUCKET=mas-documents
MINIO_SECURE=false

# ============ 1C Integration ============
