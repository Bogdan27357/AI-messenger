{
  "name": "prm-messenger",
  "version": "1.0.0",
  "description": "PRM Corporate Messenger - Pulkovo Airport",
  "main": "electron.js",
  "scripts": {
    "server": "node server/index.js",
    "client": "cd client && npx vite --host 0.0.0.0",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "cd client && npx vite build",
    "start": "node start.js",
    "start:web": "node start.js --web",
    "start:desktop": "node start.js",
    "start:rebuild": "node start.js --build",
    "electron": "electron .",
    "dist": "node build-installer.js",
    "dist:win": "node build-installer.js --win",
    "dist:mac": "node build-installer.js --mac",
    "dist:linux": "node build-installer.js --linux"
  },
  "dependencies": {
    "express": "^4.18.2",
    "sql.js": "^1.11.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "ws": "^8.16.0",
    "cors": "^2.8.5",
    "uuid": "^9.0.0",
    "concurrently": "^8.2.2"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.pulkovo.prm-messenger",
    "productName": "PRM Messenger",
    "artifactName": "PRM-Messenger-Setup-${version}.${ext}",
    "directories": {
      "output": "installer"
    },
    "files": [
      "electron.js",
      "server/**/*",
      "client/dist/**/*",
      "logo.png",
      "package.json",
      "node_modules/**/*",
      "!node_modules/electron/**",
      "!node_modules/electron-builder/**",
      "!node_modules/concurrently/**",
      "!**/*.map",
      "!**/node_modules/.cache/**"
    ],
    "extraResources": [
      {
        "from": "server/data",
        "to": "data",
        "filter": ["**/*"]
      }
    ],
    "forceCodeSigning": false,
    "icon": "logo.png",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "sign": false,
      "signingHashAlgorithms": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PRM Messenger",
      "installerLanguages": ["ru_RU"],
      "language": "1049"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "logo.png",
      "category": "public.app-category.social-networking"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "logo.png",
      "category": "Network;Chat;InstantMessaging",
      "desktop": {
        "Name": "ПРМ Мессенджер",
        "Comment": "Корпоративный мессенджер — Аэропорт Пулково"
      }
    }
  }
}
