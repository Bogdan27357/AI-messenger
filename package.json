{
  "name": "prm-messenger",
  "version": "1.0.0",
  "description": "ПРМ — корпоративный мессенджер и соцсеть для отдела дополнительного обслуживания аэропорта Пулково",
  "main": "electron.js",
  "scripts": {
    "server": "node server/index.js",
    "client": "cd client && npx vite --host 0.0.0.0",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "cd client && npx vite build",
    "start": "node start.js",
    "start:web": "node start.js --web",
    "start:desktop": "node start.js",
    "start:rebuild": "node start.js --build",
    "electron": "electron ."
  },
  "dependencies": {
    "express": "^4.18.2",
    "sql.js": "^1.11.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "ws": "^8.16.0",
    "cors": "^2.8.5",
    "uuid": "^9.0.0",
    "concurrently": "^8.2.2"
  },
  "devDependencies": {
    "electron": "^33.0.0"
  }
}
